{
  "name": "sunday-studio",
  "productName": "Sunday Studio",
  "version": "0.1.0",
  "description": "Turn full-length sermon recordings into short, captioned clips for social media.",
  "license": "MIT",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:tracker && electron-vite dev",
    "build": "npm run build:tracker && electron-vite build",
    "build:tracker": "node scripts/build-tracker.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "npm run build:release && electron-builder --mac --arm64 --publish never",
    "dist:unsigned": "npm run build:release && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never -c.mac.identity=null -c.mac.notarize=false",
    "sign": "node scripts/sign-dev.mjs",
    "build:release": "node scripts/build-tracker.mjs --force && electron-vite build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "openai": "^7.23.0",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "studio.sunday.app",
    "productName": "Sunday Studio",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "13.5",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Sunday Studio connects to AI servers on your local network (such as llama.cpp or Ollama) for clip suggestions."
      }
    },
    "copyright": "Copyright © 2026 Clay McGranahan",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "dmg": {
      "artifactName": "Sunday-Studio-arm64.${ext}",
      "title": "Sunday Studio",
      "sign": true
    }
  }
}
