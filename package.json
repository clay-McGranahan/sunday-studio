{
  "name": "sunday-studio",
  "productName": "Sunday Studio",
  "version": "0.1.0",
  "description": "Turn full-length sermon recordings into short, captioned clips for social media.",
  "license": "MIT",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:tracker && electron-vite dev",
    "build": "npm run build:tracker && electron-vite build",
    "build:tracker": "node scripts/build-tracker.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --mac",
    "dist:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never -c.mac.identity=null",
    "sign": "node scripts/sign-dev.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "studio.sunday.app",
    "productName": "Sunday Studio",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Sunday Studio connects to AI servers on your local network (such as llama.cpp or Ollama) for clip suggestions."
      }
    }
  }
}
